-- Create a database user named 'appuser' with a password from the .env file
-- (The actual user is created by the postgres image's entrypoint, but this shows how to set up)

-- This script will run automatically when the postgres container starts for the first time.
-- Here you can create tables, indexes, and other database objects.

CREATE TABLE IF NOT EXISTS users (
    id SERIAL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

