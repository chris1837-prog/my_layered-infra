{
  "name": "mvp-app",
  "version": "0.1.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "health": "node -e \"require('http').get('http://localhost:3000/health', r => process.exit(r.statusCode===200?0:1))\"",
    "test": "npm run test:internal",
    "test:internal": "jest --coverage --testPathIgnorePatterns=resilience.test.js",
    "test:resilience": "jest tests/resilience.test.js",
    "migrate": "node-pg-migrate --config pg-migrate-config.js",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:redo": "npm run migrate -- redo",
    "migrate:create": "npm run migrate -- create",
    "migrate:status": "node scripts/migrate-status.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "pino": "^10.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "node-pg-migrate": "^8.0.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
