# ===========================================================
#  .env.example – Environment variable template
# ===========================================================
# This file is a TEMPLATE that shows all environment variables
# needed to run the stack. It is safe to commit to Git.
#
# Usage:
#   1. Copy this file to `.env` in the same folder:
#        cp .env.example .env
#   2. Edit `.env` with your own local values (passwords, ports, etc).
#   3. Do NOT commit `.env` – it is ignored in .gitignore because it
#      may contain sensitive secrets.
#
# Pattern:
#   - `.env.example` → tracked, documents required variables.
#   - `.env`         → untracked, real local secrets/config.
# ===========================================================

# ===========================
# Database Configuration
# ===========================
# Postgres version to run (use LTS-ish). You can bump later.
POSTGRES_VERSION=16.10

# Logical database name, user and password the app will use.
POSTGRES_DB=myapp
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword

# ===========================
# Application Configuration
# ===========================
# The app’s HTTP port inside the container is 3000.
# We publish it as 3000 on the host (see docker-compose.yml).
PORT=3000

# The app MUST expose a /health endpoint that returns:
#  - 200 when SELECT 1 through PgBouncer succeeds
#  - 503 when it fails
HEALTH_PATH=/health

# (Optional) Some apps like splitting DB config; our compose already
# wires the app to PgBouncer using POSTGRES_* values above.
# If your app prefers individual envs, they’ll match these:
DB_HOST=pgbouncer
DB_PORT=6432
DB_NAME=${POSTGRES_DB}
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

# ===========================
# PgBouncer Configuration
# ===========================
# PgBouncer talks to Postgres at 5432 inside the compose network.
PGBOUNCER_DATABASES_HOST=postgres
PGBOUNCER_DATABASES_PORT=5432
PGBOUNCER_DATABASES_USER=${POSTGRES_USER}
PGBOUNCER_DATABASES_PASSWORD=${POSTGRES_PASSWORD}
PGBOUNCER_DATABASES_DBNAME=${POSTGRES_DB}

# Pooling settings: transaction pooling is the safest baseline.
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=100
PGBOUNCER_DEFAULT_POOL_SIZE=25

# NOTE ON AUTH:
# For the fastest local start you can leave AUTH_TYPE=trust in compose.
# For anything beyond a smoke test, switch PgBouncer to AUTH_TYPE=md5 and
# provide a userlist.txt with md5(password + username). See comments in compose.