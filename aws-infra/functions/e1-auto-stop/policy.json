{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeInstancesWithTags",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "StopQAInstances",
      "Effect": "Allow",
      "Action": "ec2:StopInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Environment": "QA"
        }
      }
    }
  ]
}