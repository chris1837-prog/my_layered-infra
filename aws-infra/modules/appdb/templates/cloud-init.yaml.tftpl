#cloud-config

# Update package index, but avoid full upgrade to prevent delays
package_update: true
package_upgrade: false

# Define groups and users
groups:
  - docker
users:
  - default
  - name: ubuntu
    groups: docker
    lock_passwd: true # Disable password login for security

# Install required packages (apt-transport-https for Docker repo)
packages:
  - apt-transport-https
  - ca-certificates
  - curl
  - gnupg
  - lsb-release

# Run commands to set up Docker and test the setup
runcmd:
  # Add Docker's official GPG key
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg || echo "Failed to add Docker GPG key" >> /var/log/cloud-init-error.log

  # Add Docker's official repository
  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null || echo "Failed to add Docker repo" >> /var/log/cloud-init-error.log

  # Update package index again after adding Docker repo
  - apt-get update || echo "Failed to update apt after adding Docker repo" >> /var/log/cloud-init-error.log

  # Install Docker CE and related tools
  - apt-get install -y docker-ce docker-ce-cli containerd.io || echo "Failed to install Docker" >> /var/log/cloud-init-error.log

  # Ensure Docker service is started and enabled
  - systemctl start docker || echo "Failed to start Docker" >> /var/log/cloud-init-error.log
  - systemctl enable docker || echo "Failed to enable Docker" >> /var/log/cloud-init-error.log

  # Pull Nginx image to test Docker Hub connectivity
  - docker pull nginx || echo "Failed to pull Nginx image" >> /var/log/cloud-init-error.log

  # Run Nginx container in detached mode, mapping port 80
  - docker run -d -p 80:80 --name nginx-test nginx || echo "Failed to run Nginx container" >> /var/log/cloud-init-error.log

  # Test outbound internet connectivity
  - curl -v https://google.com || echo "Failed to curl Google" >> /var/log/cloud-init-error.log

  # Log success for debugging
  - echo "Cloud-init completed successfully" >> /var/log/cloud-init-output.log

  # Install and config promtail
  - - /bin/bash
    - -c
    - |
      set -euxo pipefail
      echo "[RUNCMD] Setting up Promtail on App VM" >> /var/log/appdb-init.log

      mkdir -p /etc/promtail

      # Deploy Promtail config (Content is provided as a pre-rendered string from main.tf)
      cat > /etc/promtail/promtail-config-app.yml <<EOF
      ${promtail_config_content}
      EOF

      # Install Promtail binary
      promtail_version="${PROMTAIL_VERSION}" # Terraform variable PROMTAIL_VERSION passed to shell variable promtail_version
      curl -Lo /tmp/promtail.zip https://github.com/grafana/loki/releases/download/v$${promtail_version}/promtail-linux-amd64.zip
      unzip /tmp/promtail.zip -d /usr/local/bin/
      chmod +x /usr/local/bin/promtail

      # Create systemd service
      cat > /etc/systemd/system/promtail.service <<EOF
      [Unit]
      Description=Promtail Service (App VM)
      After=network.target

      [Service]
      ExecStart=/usr/local/bin/promtail --config.file=/etc/promtail/promtail-config-app.yml
      Restart=always

      [Install]
      WantedBy=multi-user.target
      EOF

      systemctl daemon-reload
      systemctl enable --now promtail
      echo "[RUNCMD] Promtail setup complete" >> /var/log/appdb-init.log

  - - /bin/bash
    - -c
    - |
      # Install and enable Node Exporter
      set -euxo pipefail
      node_exp_ver="${NODE_EXP_VER}" # Terraform variable NODE_EXP_VER passed to shell variable node_exp_ver
      cd /tmp
      curl -fsSL -O https://github.com/prometheus/node_exporter/releases/download/v$${node_exp_ver}/node_exporter-$${node_exp_ver}.linux-amd64.tar.gz
      tar xzf node_exporter-$${node_exp_ver}.linux-amd64.tar.gz
      mv node_exporter-$${node_exp_ver}.linux-amd64/node_exporter /usr/local/bin/
      id -u nodeexp >/dev/null 2>&1 || useradd -r -s /usr/sbin/nologin nodeexp
      chown nodeexp:nodeexp /usr/local/bin/node_exporter

      cat >/etc/systemd/system/node_exporter.service <<'UNIT'
      [Unit]
      Description=Prometheus Node Exporter
      After=network-online.target

      [Service]
      User=nodeexp
      ExecStart=/usr/local/bin/node_exporter
      Restart=on-failure

      [Install]
      WantedBy=multi-user.target
      UNIT

      systemctl daemon-reload
      systemctl enable --now node_exporter
      echo "[RUNCMD] Node Exporter setup complete" >> /var/log/appdb-init.log

  # Mount EBS Volume for PostgreSQL and register in etc/fstab
  - echo "[mount-postgres-ebs] Mounting EBS volume"
  - DEVICE="${db_volume_device_name}"
  - MOUNTPOINT="${db_volume_mount_path}" # default /var/lib/postgresql/data
  - mkdir -p $MOUNTPOINT
  - if ! blkid $DEVICE; then mkfs.ext4 -E lazy_itable_init=0,lazy_journal_init=0 $DEVICE; fi
  - UUID=$(blkid -s UUID -o value $DEVICE)
  - if ! grep -q $UUID /etc/fstab; then echo "UUID=$UUID $MOUNTPOINT ext4 noatime,nofail 0 2" >> /etc/fstab; fi
  - mount -a
  - chown -R 999:999 $MOUNTPOINT
  - chmod 700 $MOUNTPOINT
  - echo "[mount-postgres-ebs] Volume ready at $MOUNTPOINT"

  # Log success for debugging
  - echo "Cloud-init completed successfully" >> /var/log/cloud-init-output.log
