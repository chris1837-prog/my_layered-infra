#cloud-config
package_update: true
package_upgrade: true
packages:
  - docker.io
  - docker-compose-plugin
  - awscli
  - jq
  - curl

write_files:
  # systemd service for appdb stack
  - path: /etc/systemd/system/appdb.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Docker Compose AppDB stack
      Requires=docker.service
      After=docker.service

      [Service]
      WorkingDirectory=/opt/appdb
      ExecStart=/usr/local/bin/appdb-start.sh
      ExecStop=/usr/bin/docker compose down
      Restart=always
      RestartSec=10s

      [Install]
      WantedBy=multi-user.target

  # bootstrap/start script
  - path: /usr/local/bin/appdb-start.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      retry() { n=0; until "$@"; do n=$((n+1)); [ $n -ge 10 ] && return 1; sleep $((6+n)); done; }

      # Metadata
      TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
      REGION=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/dynamic/instance-identity/document | jq -r .region)

      # Fetch all params in one go
      PARAM_PATH="/${project_name}/${environment}"
      PARAMS=$(aws ssm get-parameters-by-path --region "$REGION" --path "$PARAM_PATH" --with-decryption)

      get_param() {
        echo "$PARAMS" | jq -r --arg name "$PARAM_PATH/$1" '.Parameters[] | select(.Name==$name) | .Value'
      }

      # Extract values
      REGISTRY_URL=$(get_param "registry_url")
      IMAGE_TAG=$(get_param "app_image_tag")
      POSTGRES_USER=$(get_param "postgres_user")
      POSTGRES_PASSWORD=$(get_param "postgres_password")
      POSTGRES_DB=$(get_param "postgres_db")

      # Ensure working directory
      mkdir -p /opt/appdb
      cd /opt/appdb

      # Write override compose file
      cat > docker-compose.override.yml <<EOF
      services:
        app:
          image: \${REGISTRY_URL}/myapp:\${IMAGE_TAG}
          environment:
            POSTGRES_DB: \${POSTGRES_DB}
            POSTGRES_USER: \${POSTGRES_USER}
            POSTGRES_PASSWORD: \${POSTGRES_PASSWORD}
            DATABASE_URL: "postgresql://$${POSTGRES_USER}:$${POSTGRES_PASSWORD}@pgbouncer:6432/$${POSTGRES_DB}"
        postgres:
          environment:
            POSTGRES_DB: \${POSTGRES_DB}
            POSTGRES_USER: \${POSTGRES_USER}
            POSTGRES_PASSWORD: \${POSTGRES_PASSWORD}
        pgbouncer:
          environment:
            DB_NAME: \${POSTGRES_DB}
            DB_USER: \${POSTGRES_USER}
            DB_PASSWORD: \${POSTGRES_PASSWORD}
      EOF

      # Retry docker compose pull (no login needed inside VPC)
      retry docker compose -f docker-compose.yml -f docker-compose.override.yml pull

      # Start stack
      exec docker compose -f docker-compose.yml -f docker-compose.override.yml up --remove-orphans

runcmd:
  - mkdir -p /opt/appdb
  - cd /opt/appdb
  # Write base compose file from Terraform
  - echo '${DOCKER_COMPOSE_CONTENT}' > docker-compose.yml
  - systemctl daemon-reload
  - systemctl enable appdb.service
  - systemctl start appdb.service
  # Give docker service time to start properly
  - sleep 10
  - systemctl start appdb.service