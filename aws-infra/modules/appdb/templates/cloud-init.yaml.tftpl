%{ set sanitized_volume_id = replace(db_volume_id, "-", "") }
#cloud-config

package_update: true
package_upgrade: false
packages:
  - docker.io
  - docker-compose-plugin
  - jq
  - awscli

write_files:
  - path: /opt/layered/bin/ensure-db-volume.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/bash
      set -Eeuo pipefail

      MOUNT_PATH="${db_volume_mount_path}"
      DEVICE_HINT="${db_volume_device_name}"
      VOLUME_ID="${db_volume_id}"
      SANITIZED_ID="${sanitized_volume_id}"
      DEVICE_SYMLINK="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${sanitized_volume_id}"

      log() {
        printf '%s ensure-db-volume: %s\n' "$(date --iso-8601=seconds)" "$1"
      }

      DEVICE=""
      for attempt in $(seq 1 30); do
        if [ -b "$DEVICE_SYMLINK" ]; then
          DEVICE=$(readlink -f "$DEVICE_SYMLINK")
          log "Detected NVMe symlink $DEVICE_SYMLINK -> $DEVICE"
          break
        fi
        if [ -b "$DEVICE_HINT" ]; then
          DEVICE="$DEVICE_HINT"
          log "Falling back to hinted device $DEVICE_HINT"
          break
        fi
        sleep 2
      done

      if [ -z "$DEVICE" ]; then
        log "Failed to locate block device for volume $VOLUME_ID"
        exit 1
      fi

      if ! blkid "$DEVICE" >/dev/null 2>&1; then
        log "Formatting $DEVICE as ext4"
        mkfs.ext4 -F "$DEVICE"
      else
        log "$DEVICE already formatted"
      fi

      mkdir -p "$MOUNT_PATH"

      if ! mountpoint -q "$MOUNT_PATH"; then
        log "Mounting $DEVICE at $MOUNT_PATH"
        mount "$DEVICE" "$MOUNT_PATH"
      else
        log "$MOUNT_PATH already mounted"
      fi

      UUID=$(blkid -s UUID -o value "$DEVICE")
      if ! grep -q "$UUID" /etc/fstab; then
        log "Persisting mount to /etc/fstab"
        echo "UUID=$UUID $MOUNT_PATH ext4 defaults,nofail 0 2" >> /etc/fstab
      fi

      chmod 0755 "$MOUNT_PATH"
      echo "$DEVICE" > /opt/layered/db-volume-device

  - path: /opt/layered/bin/render-compose-env.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/bash
      set -Eeuo pipefail

      REGION=$(curl -fs http://169.254.169.254/latest/dynamic/instance-identity/document | jq -r '.region')

      fetch() {
        local name="$1"
        if [ -z "$name" ] || [ "$name" = "null" ]; then
          echo "" && return 0
        fi
        aws ssm get-parameter --with-decryption --region "$REGION" --name "$name" --query 'Parameter.Value' --output text
      }

      POSTGRES_DB=$(fetch "${postgres_db_path}")
      POSTGRES_USER=$(fetch "${postgres_user_path}")
      POSTGRES_PASSWORD=$(fetch "${postgres_password_path}")
      APP_IMAGE_NAME=$(fetch "${app_image_name_path}")
      APP_IMAGE_TAG=$(fetch "${app_image_tag_path}")
      INTERNAL_REGISTRY_URL=$(fetch "${internal_registry_url_path}")

      REGISTRY_USER_PATH="${registry_user_path}"
      REGISTRY_PASSWORD_PATH="${registry_password_path}"

      if [ -z "$POSTGRES_DB" ] || [ -z "$POSTGRES_USER" ] || [ -z "$POSTGRES_PASSWORD" ]; then
        echo "Postgres parameters missing" >&2
        exit 1
      fi

      umask 027
      cat <<ENVEOF >/opt/layered/mvp-compose/.env
POSTGRES_DB=${POSTGRES_DB}
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DATA_SOURCE=${db_volume_mount_path}
APP_IMAGE_NAME=${APP_IMAGE_NAME}
APP_IMAGE_TAG=${APP_IMAGE_TAG}
INTERNAL_REGISTRY_URL=${INTERNAL_REGISTRY_URL}
ENVEOF

      if [ -n "$REGISTRY_USER_PATH" ] && [ "$REGISTRY_USER_PATH" != "null" ] && [ -n "$REGISTRY_PASSWORD_PATH" ] && [ "$REGISTRY_PASSWORD_PATH" != "null" ] && [ -n "$INTERNAL_REGISTRY_URL" ]; then
        REGISTRY_USER=$(fetch "$REGISTRY_USER_PATH")
        REGISTRY_PASSWORD=$(fetch "$REGISTRY_PASSWORD_PATH")
        if [ -n "$REGISTRY_USER" ] && [ -n "$REGISTRY_PASSWORD" ]; then
          echo "$REGISTRY_PASSWORD" | docker login --username "$REGISTRY_USER" --password-stdin "$INTERNAL_REGISTRY_URL"
        fi
      fi

  - path: /opt/layered/bin/bootstrap-compose.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/bash
      set -Eeuo pipefail
      cd /opt/layered/mvp-compose
      docker compose pull postgres pgbouncer || true
      docker compose up -d

  - path: /opt/layered/mvp-compose/docker-compose.yml
    owner: root:root
    permissions: '0644'
    content: |
%{ indent(6, docker_compose_content) }

  - path: /etc/systemd/system/ensure-db-volume.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Ensure Postgres data volume is present, formatted, and mounted
      DefaultDependencies=no
      After=network-online.target
      Wants=network-online.target
      Before=docker.service layered-compose.service

      [Service]
      Type=oneshot
      ExecStart=/opt/layered/bin/ensure-db-volume.sh
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/layered-compose.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Layered Infra application stack (Docker Compose)
      After=docker.service ensure-db-volume.service network-online.target
      Requires=docker.service ensure-db-volume.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/opt/layered/mvp-compose
      ExecStartPre=/opt/layered/bin/render-compose-env.sh
      ExecStart=/usr/bin/docker compose up -d
      ExecStop=/usr/bin/docker compose down
      TimeoutStartSec=600

      [Install]
      WantedBy=multi-user.target

runcmd:
  - [ bash, -c, 'mkdir -p /opt/layered/bin /opt/layered/mvp-compose' ]
  - [ systemctl, daemon-reload ]
  - [ systemctl, enable, --now, docker ]
  - [ systemctl, enable, ensure-db-volume.service ]
  - [ systemctl, start, ensure-db-volume.service ]
  - [ systemctl, enable, layered-compose.service ]
  - [ systemctl, start, layered-compose.service ]
