#cloud-config
package_update: true
package_upgrade: true
packages:
  - docker.io
  - docker-compose-plugin
  - awscli
  - jq
  - curl

write_files:
  # systemd service for appdb stack
  - path: /etc/systemd/system/appdb.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Docker Compose AppDB stack
      Requires=docker.service
      After=docker.service

      [Service]
      WorkingDirectory=/opt/appdb
      ExecStart=/usr/local/bin/appdb-start.sh
      ExecStop=/usr/bin/docker compose down
      Restart=always
      RestartSec=10s

      [Install]
      WantedBy=multi-user.target

  # bootstrap/start script
  - path: /usr/local/bin/appdb-start.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      retry() { n=0; until "$@"; do n=$((n+1)); [ $n -ge 10 ] && return 1; sleep $((6+n)); done; }

      # Metadata
      TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
      REGION=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/dynamic/instance-identity/document | jq -r .region)

      # Fetch all params explicitly
      PARAMS=$(aws ssm get-parameters --region "$REGION" --with-decryption \
        --names \
          "${internal_registry_url_path}" \
          "${registry_user_path}" \
          "${registry_password_path}" \
          "${app_image_tag_path}" \
          "${postgres_user_path}" \
          "${postgres_password_path}" \
          "${postgres_db_path}")

      get_param() {
        echo "$PARAMS" | jq -r --arg name "$1" '.Parameters[] | select(.Name==$name) | .Value'
      }

      # Extract values
      INTERNAL_REGISTRY_URL=$(get_param "${internal_registry_url_path}")
      REGISTRY_USER=$(get_param "${registry_user_path}")
      REGISTRY_PASSWORD=$(get_param "${registry_password_path}")
      IMAGE_TAG=$(get_param "${app_image_tag_path}")
      POSTGRES_USER=$(get_param "${postgres_user_path}")
      POSTGRES_PASSWORD=$(get_param "${postgres_password_path}")
      POSTGRES_DB=$(get_param "${postgres_db_path}")

      # App image repo/name provided via template
      APP_IMAGE_REPO='${app_image_repo}'

      # Compose image
      IMAGE="${INTERNAL_REGISTRY_URL}/${APP_IMAGE_REPO}:${IMAGE_TAG}"

      # Ensure working directory
      mkdir -p /opt/appdb
      cd /opt/appdb

      # Docker login (needed for pushing/pulling images if registry enforces auth)
      echo "$REGISTRY_PASSWORD" | docker login "$INTERNAL_REGISTRY_URL" -u "$REGISTRY_USER" --password-stdin

      # Write override compose file
      cat > docker-compose.override.yml <<EOF
      services:
        app:
          image: \${IMAGE}
          environment:
            POSTGRES_DB: \${POSTGRES_DB}
            POSTGRES_USER: \${POSTGRES_USER}
            POSTGRES_PASSWORD: \${POSTGRES_PASSWORD}
            DATABASE_URL: "postgresql://$${POSTGRES_USER}:$${POSTGRES_PASSWORD}@pgbouncer:6432/$${POSTGRES_DB}"
        postgres:
          environment:
            POSTGRES_DB: \${POSTGRES_DB}
            POSTGRES_USER: \${POSTGRES_USER}
            POSTGRES_PASSWORD: \${POSTGRES_PASSWORD}
        pgbouncer:
          environment:
            DB_NAME: \${POSTGRES_DB}
            DB_USER: \${POSTGRES_USER}
            DB_PASSWORD: \${POSTGRES_PASSWORD}
      EOF

      # Retry docker compose pull
      retry docker compose -f docker-compose.yml -f docker-compose.override.yml pull

      # Start stack
      exec docker compose -f docker-compose.yml -f docker-compose.override.yml up --remove-orphans

runcmd:
  - mkdir -p /opt/appdb
  - cd /opt/appdb
  # Write base compose file from Terraform
  - echo '${docker_compose_content}' > docker-compose.yml
  - systemctl daemon-reload
  - systemctl enable appdb.service
  - systemctl start appdb.service
  # Give docker service time to start properly
  - sleep 10
  - systemctl start appdb.service
