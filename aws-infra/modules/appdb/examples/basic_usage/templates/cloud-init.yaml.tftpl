#cloud-config
package_update: true
package_upgrade: true
packages:
  - docker.io

runcmd:
  - systemctl enable docker
  - systemctl start docker
  # Create custom index.html
  - mkdir -p /opt/appdb/html
  - echo "Hello from nginx!" > /opt/appdb/html/index.html
  # Pull image and run nginx with mounted custom page
  - docker pull ${APP_IMAGE}
  - docker run -d -p 80:80 --name appdb-test \
      -v /opt/appdb/html:/usr/share/nginx/html:ro \
      ${APP_IMAGE}

final_message: "Cloud-init completed for AppDB instance with image ${APP_IMAGE}"

