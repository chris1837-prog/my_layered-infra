
# Example terraform.tfvars for the edge module
# Fill in your actual VPC and subnet IDs
vpc_id            = "vpc-xxxxxxxxxxxxxxxxx"
public_subnet_id  = "subnet-xxxxxxxxxxxxxxxxx"

# AWS region and profile
aws_region    = "eu-central-1"
aws_profile   = "AdministratorAccess-694816839566"

# Instance type
instance_type = "t3.micro"

# Admin CIDRs (allowed SSH/WireGuard sources)
admin_cidrs   = ["0.0.0.0/0"]

# Domain name for Caddy
domain_name   = "edge.example.com"

# Backend servers for reverse proxy
backend_servers = ["10.0.2.10:3000", "10.0.2.11:3000"]