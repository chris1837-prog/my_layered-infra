#cloud-config

apt:
  debconf_selections:
    - 'iptables-persistent iptables-persistent/autosave_v4 boolean true'
    - 'iptables-persistent iptables-persistent/autosave_v6 boolean true'

package_update: true
package_upgrade: true
packages:
  - ufw
  - iptables-persistent
  - netfilter-persistent
  - curl
  - ca-certificates
  - debian-keyring
  - debian-archive-keyring
  - apt-transport-https
  - openssl
  - wireguard
  - qrencode
  - fail2ban

bootcmd:
  - echo "[BOOTCMD] edge bootcmd executed $(date -Is)" > /var/log/edge-bootcmd.log

users:
  - name: ${admin_user}
    primary_group: sudo
    groups: [sudo]
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    ssh_authorized_keys: ${jsonencode(admin_ssh_keys)}

write_files:
  - path: /var/log/edge-userdata-pre.log
    owner: root:root
    permissions: "0644"
    content: |
      [PRE] user-data write_files section reached at $(date -Is)
  - path: /etc/caddy/Caddyfile
    owner: root:root
    permissions: "0644"
    content: |
      # Generated Caddyfile (single-template inline)
      %{ if acme_email != "" }
      {
        email ${acme_email}
      }
      %{ endif }

      %{ if enable_domain_tls }
      ${domain_name} {
        # Primary application domain reverse proxy
        reverse_proxy ${join(" ", backend_servers)}
        %{ if enable_domain_acme }
        # Public ACME certificate (automatic HTTPS). Do NOT specify a tls block; Caddy will manage issuance & renewals.
        %{ else }
        # Internal CA certificate (self-signed via Caddy local CA)
        tls internal
        %{ endif }
      }
      %{ else }
      http://${domain_name} {
        # HTTP-only bootstrap mode (no TLS yet) – useful to validate routing before enabling HTTPS
        reverse_proxy ${join(" ", backend_servers)}
      }
      %{ endif }

      ${registry_external_url} {
        # External split-horizon host (public)
        reverse_proxy localhost:5000
        %{ if enable_acme_external }
        # Use public ACME cert (Let's Encrypt). No explicit tls block needed; Caddy automatic HTTPS will obtain ACME cert.
        # (An explicit empty tls { } block caused a parse error in Caddy 2.10.2.)
        %{ else }
        # Use internal CA and expose /ca.crt for external clients
        tls internal
        handle /ca.crt {
          root * /var/www/caddy
          file_server
        }
        %{ endif }
      }

      ${registry_internal_url} {
        # Internal split-horizon host
        # Always trust internal CA; expose CA for internal clients
        handle /ca.crt {
          root * /var/www/caddy
          file_server
        }
        reverse_proxy localhost:5000
        tls internal
      }

      loki.dev.uselayered.com {
      # Observability: expose Loki through the edge
      reverse_proxy http://loki:3100
      tls internal
      }

      prometheus.dev.uselayered.com {
      # Observability: expose Prometheus through the edge
      reverse_proxy http://prometheus:9090
      tls internal
      }

  - path: /etc/fail2ban/jail.local
    owner: root:root
    permissions: "0644"
    content: |
      [sshd]
      enabled  = true
      port     = ssh
      filter   = sshd
      logpath  = /var/log/auth.log
      maxretry = 5
      bantime  = 15m
      findtime = 10m

  - path: /opt/startup.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euxo pipefail
      export DEBIAN_FRONTEND=noninteractive
      mkdir -p /var/lib/cloud/instance || true
      trap 'echo "[ERROR] startup.sh failed at line $LINENO" | tee -a /var/log/edge-init.log; touch /var/lib/cloud/instance/cloud-init-failed' ERR
      echo "[INIT] startup.sh begun" | tee -a /var/log/edge-init.log
      echo "[MARK] init-begin $(date -Is)" >> /var/log/edge-progress.log

      echo "[INIT] Installing/starting Docker..."
      if ! command -v docker >/dev/null 2>&1; then
        apt-get update
        apt-get install -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" docker.io
      fi
      echo "[MARK] docker-section-complete $(date -Is)" >> /var/log/edge-progress.log
      systemctl enable --now docker
      # Allow SSH users to run docker without sudo
      if id -u ${admin_user} >/dev/null 2>&1; then
        usermod -aG docker ${admin_user} || true
      fi

      # Wait for Docker CLI to be available, to avoid races with apt/links
      echo "[INIT] Waiting for Docker CLI to become available..."
      for i in $(seq 1 30); do
        if command -v docker >/dev/null 2>&1; then
          docker --version || true
          echo "[INIT] Docker CLI detected."
          break
        fi
        sleep 5
      done
      if ! command -v docker >/dev/null 2>&1; then
        echo "[WARN] Docker CLI still not found after waiting; showing diagnostics..." | tee -a /var/log/edge-init.log
        which docker || true
        dpkg -l | grep -i docker || true
        apt-cache policy docker.io || true
      fi

      echo "[INIT] Preparing registry directories and credentials..."
      mkdir -p /opt/registry/data /opt/registry/auth
      docker run --rm --entrypoint htpasswd httpd:2 -Bbn "${registry_user}" "${registry_password}" > /opt/registry/auth/htpasswd

      echo "[INIT] Running Docker registry container..."
      docker run -d --restart=always --name registry \
        -e REGISTRY_AUTH=htpasswd \
        -e REGISTRY_AUTH_HTPASSWD_REALM="Registry Realm" \
        -e REGISTRY_AUTH_HTPASSWD_PATH=/auth/htpasswd \
        -v /opt/registry/data:/var/lib/registry \
        -v /opt/registry/auth:/auth \
        -p 5000:5000 \
        registry:2

      echo "[INIT] Enabling IP forwarding for NAT..."
      sysctl -w net.ipv4.ip_forward=1
      sed -i 's/^#net.ipv4.ip_forward=1/net.ipv4.ip_forward=1/' /etc/sysctl.conf
      PRIMARY_IFACE=$(ip route show default | awk '{print $5}' | head -n1)
      iptables -t nat -A POSTROUTING -o "$PRIMARY_IFACE" -j MASQUERADE
      iptables-save > /etc/iptables/rules.v4

      echo "[INIT] Adding Caddy repository..."
      apt-get install -y debian-keyring debian-archive-keyring apt-transport-https
      curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
      echo "deb [signed-by=/usr/share/keyrings/caddy-stable-archive-keyring.gpg] https://dl.cloudsmith.io/public/caddy/stable/deb/debian any-version main" > /etc/apt/sources.list.d/caddy-stable.list
      apt-get update

      echo "[INIT] Installing Caddy..."
      export DEBIAN_FRONTEND=noninteractive
      apt-get install -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" caddy
      echo "[INIT] Caddy has been installed."

      # NOTE: Do NOT modify /etc/hosts for registry domains here.
      # Split-horizon DNS is expected to resolve these differently inside vs outside.
      # Tests may pin hostnames as needed, but the appliance should not hardcode DNS.

      echo "[INIT] Configuring firewall with UFW..."
      ufw default deny incoming
      ufw default allow outgoing
      ufw allow 80/tcp
      ufw allow 443/tcp
      %{ for cidr in admin_cidrs ~}
      ufw allow from ${cidr} to any port 22 proto tcp
      ufw allow from ${cidr} to any port ${wireguard_port} proto udp
      %{ endfor ~}
      ufw --force enable

      %{ if enable_wireguard }
      echo "[INIT] Setting up WireGuard server (enabled)..."
      mkdir -p /etc/wireguard
      if [ ! -f /etc/wireguard/server_private.key ]; then
        wg genkey | tee /etc/wireguard/server_private.key | wg pubkey > /etc/wireguard/server_public.key
      fi
      echo "[INIT] Writing WireGuard configuration..."
      {
        echo "[Interface]"
        echo "PrivateKey = $(cat /etc/wireguard/server_private.key)"
        echo "Address = 10.200.0.1/24"
        echo "ListenPort = ${wireguard_port}"
        echo "SaveConfig = true"
      } > /etc/wireguard/wg0.conf
      systemctl enable --now wg-quick@wg0
      %{ else }
      echo "[INIT] Skipping WireGuard setup (enable_wireguard=false)" | tee -a /var/log/edge-init.log
      %{ endif }

      echo "[INIT] Formatting Caddyfile..."
      caddy fmt --overwrite /etc/caddy/Caddyfile || true

      echo "[INIT] Enabling and starting Caddy to apply templated config..."
      systemctl enable --now caddy

      echo "[INIT] Installing Caddy internal CA to Docker and OS trust stores (only when internal CA is used)..."
      CA_SRC1="/var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt"
      CA_SRC2="/var/lib/caddy/pki/authorities/local/root.crt"
      CA_SRC=""
      # Wait briefly for Caddy to generate its local CA
      for i in $(seq 1 15); do
        if [ -f "$CA_SRC1" ]; then CA_SRC="$CA_SRC1"; break; fi
        if [ -f "$CA_SRC2" ]; then CA_SRC="$CA_SRC2"; break; fi
        sleep 2
      done
      # Derive hostnames from full registry URLs (avoid passing separate host vars)
      REGISTRY_EXTERNAL_HOST=$(echo "${registry_external_url}" | sed -E 's#https://([^/]+)/?.*#\1#')
      REGISTRY_INTERNAL_HOST=$(echo "${registry_internal_url}" | sed -E 's#https://([^/]+)/?.*#\1#')
      DEST_DIR_EXT="/etc/docker/certs.d/${REGISTRY_EXTERNAL_HOST}"
      DEST_DIR_EXT_PORT="/etc/docker/certs.d/${REGISTRY_EXTERNAL_HOST}:443"
      DEST_DIR_INT="/etc/docker/certs.d/${REGISTRY_INTERNAL_HOST}"
      DEST_DIR_INT_PORT="/etc/docker/certs.d/${REGISTRY_INTERNAL_HOST}:443"
      install -d -m 0755 "$DEST_DIR_EXT" "$DEST_DIR_EXT_PORT" "$DEST_DIR_INT" "$DEST_DIR_INT_PORT"
      if [ -n "$CA_SRC" ] && [ -f "$CA_SRC" ]; then
        # For external domain, only install CA if we're not using ACME
      %{ if enable_acme_external ~}
        # ACME enabled for external domain; do not install local CA into external trust dirs
      %{ else ~}
        install -m 0644 -D "$CA_SRC" "$DEST_DIR_EXT/ca.crt"
        install -m 0644 -D "$CA_SRC" "$DEST_DIR_EXT_PORT/ca.crt"
      %{ endif ~}
        install -m 0644 -D "$CA_SRC" "$DEST_DIR_INT/ca.crt"
        install -m 0644 -D "$CA_SRC" "$DEST_DIR_INT_PORT/ca.crt"
        # Also expose the CA via HTTPS at /ca.crt for external clients
      %{ if enable_acme_external ~}
        # ACME in use externally; skip exposing CA for external
      %{ else ~}
        install -d -m 0755 /var/www/caddy
        install -m 0644 -D "$CA_SRC" /var/www/caddy/ca.crt
      %{ endif ~}
        install -m 0644 -D "$CA_SRC" /usr/local/share/ca-certificates/caddy-local.crt
        update-ca-certificates || true
        echo "[INIT] CA installed to Docker (external+internal) and OS trust; restarting Docker..."
        systemctl restart docker
      else
        echo "[WARN] Caddy internal CA not found; Docker CLI may not trust registry TLS"
      fi

      echo "[INIT] Enabling fail2ban..."
      systemctl enable --now fail2ban
      fail2ban-client status sshd || true

      # -----------------------------
      # Observability stack setup
      # -----------------------------
      echo "[INIT] Setting up observability stack..." >> /var/log/edge-init.log

      # Create directories
      mkdir -p /opt/observability /etc/promtail

      # Write docker-compose observability file (Terraform template injects content)
      cat > /opt/observability/docker-compose.observability.yml <<EOF
      ${templatefile("${path_module}/templates/docker-compose.observability.yml.tftpl", {})}
      EOF

      # Write Promtail config file
      cat > /etc/promtail/promtail-config.yml <<EOF
      ${templatefile("${path_module}/templates/promtail-config-edge.yml.tftpl", {})}
      EOF
      
      # Write Prometheus config file
      cat > /opt/observability/prometheus.yml <<EOF
      ${templatefile("${path_module}/templates/prometheus.yml.tftpl", {
        app_private_ip = app_private_ip
      })}
      EOF

      # Launch observability containers
      docker compose -f /opt/observability/docker-compose.observability.yml up -d

      # Install Promtail binary
      promtail_version ="${promtail_version}"
      curl -Lo /tmp/promtail.zip https://github.com/grafana/loki/releases/download/v$${promtail_version}/promtail-linux-amd64.zip
      unzip /tmp/promtail.zip -d /usr/local/bin/
      chmod +x /usr/local/bin/promtail

      # Create Promtail systemd service
      cat > /etc/systemd/system/promtail.service <<EOF
      [Unit]
      Description=Promtail Service
      After=network.target

      [Service]
      ExecStart=/usr/local/bin/promtail --config.file=/etc/promtail/promtail-config.yml
      Restart=always

      [Install]
      WantedBy=multi-user.target
      EOF

      # Enable and start Promtail
      systemctl daemon-reload
      systemctl enable --now promtail

      echo "[INIT] Observability stack setup complete." >> /var/log/edge-init.log

      echo "[INIT] Script finished successfully."
      echo "[MARK] final-success $(date -Is)" >> /var/log/edge-progress.log
      touch /var/lib/cloud/instance/edge-init-finished
      ls -l /var/lib/cloud/instance/edge-init-finished || true

      

  - path: /etc/systemd/system/edge-startup.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Edge module bootstrap (fallback)\n
      After=network-online.target docker.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/opt/startup.sh
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

runcmd:
  - [ bash, -c, "echo '[RUNCMD] minimal execution starting $(date -Is)' > /var/log/edge-debug.log" ]
  - [ bash, /opt/startup.sh ]
  - |
    # Install and enable Node Exporter
    set -euxo pipefail
    NODE_EXP_VER="1.8.1"
    cd /tmp
    curl -fsSL -O https://github.com/prometheus/node_exporter/releases/download/v${NODE_EXP_VER}/node_exporter-${NODE_EXP_VER}.linux-amd64.tar.gz
    tar xzf node_exporter-${NODE_EXP_VER}.linux-amd64.tar.gz
    mv node_exporter-${NODE_EXP_VER}.linux-amd64/node_exporter /usr/local/bin/
    id -u nodeexp >/dev/null 2>&1 || useradd -r -s /usr/sbin/nologin nodeexp
    chown nodeexp:nodeexp /usr/local/bin/node_exporter

    cat >/etc/systemd/system/node_exporter.service <<'UNIT'
    [Unit]
    Description=Prometheus Node Exporter
    After=network-online.target

    [Service]
    User=nodeexp
    ExecStart=/usr/local/bin/node_exporter
    Restart=on-failure

    [Install]
    WantedBy=multi-user.target
    UNIT

    systemctl daemon-reload
    systemctl enable --now node_exporter