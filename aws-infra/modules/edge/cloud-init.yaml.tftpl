#cloud-config

apt:
  debconf_selections:
    iptables-persistent: iptables-persistent/autosave_v4 boolean true
    iptables-persistent: iptables-persistent/autosave_v6 boolean true
package_update: true
package_upgrade: true
packages:
  - ufw
  - iptables-persistent
  - netfilter-persistent
  - curl
  - gnupg
  - debian-keyring
  - debian-archive-keyring
  - apt-transport-https
  - openssl
  - wireguard
  - qrencode

users:
  - name: ${admin_user}
    primary_group: sudo
    groups: [sudo]
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    ssh_authorized_keys:
%{ for key in admin_ssh_keys }
      - ${key}
%{ endfor }

write_files:
  - path: /var/www/html/index.html
    owner: root:root
    permissions: "0644"
    content: "edge alive!"

  - path: /etc/caddy/Caddyfile
    owner: root:root
    permissions: "0644"
    content: |
      # Health check endpoint (always active)
      :8080 {
        bind 127.0.0.1

        handle /health {
          respond "edge alive" 200
        }

        handle {
          respond "Not Found" 404
        }
      }

      # Internal site
      myinternal.lan {
        root * /var/www/html
        file_server
        tls internal
      }

      # External domain (if provided)
      %{ if domain_name != "" ~}
      http://${domain_name} {
        redir https://{host}{uri} permanent
      }

      https://${domain_name} {
        tls {
          protocols tls1.2 tls1.3
        }

        %{ if length(backend_servers) > 0 ~}
        reverse_proxy {
          to ${join(" ", backend_servers)}
          header_up Host {upstream_hostport}
          header_up X-Real-IP {remote_host}
          header_up X-Forwarded-For {remote_host}
          header_up X-Forwarded-Proto {scheme}
          header_up X-Forwarded-Port {server_port}
        }
        %{ else ~}
        root * /var/www/html
        file_server
        %{ endif ~}
      }
      %{ endif ~}

runcmd:
  # Enable NAT & forwarding
  - [ sysctl, -w, net.ipv4.ip_forward=1 ]
  - [ sed, -i, 's/^#net.ipv4.ip_forward=1/net.ipv4.ip_forward=1/', /etc/sysctl.conf ]
  - [ iptables, -t, nat, -A, POSTROUTING, -o, ens5, -j, MASQUERADE ]
  - [ sh, -c, "iptables-save > /etc/iptables/rules.v4" ]

  # Caddy installation
  - [ sh, -c, 'curl -1sLf "https://dl.cloudsmith.io/public/caddy/stable/gpg.key" | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg' ]
  - [ sh, -c, 'echo "deb [signed-by=/usr/share/keyrings/caddy-stable-archive-keyring.gpg] https://dl.cloudsmith.io/public/caddy/stable/deb/debian any-version main" > /etc/apt/sources.list.d/caddy-stable.list' ]
  - [ apt-get, update ]
  - [ apt-get, install, -y, caddy ]
  - [ mkdir, -p, /var/lib/caddy/.config ]
  - [ chown, -R, caddy:caddy, /var/lib/caddy ]
  - [ chmod, 700, /var/lib/caddy ]
  - [ systemctl, enable, caddy ]
  - [ systemctl, start, caddy ]

  # UFW Firewall
  - [ ufw, default, deny, incoming ]
  - [ ufw, default, allow, outgoing ]
  - [ ufw, allow, 80/tcp ]
  - [ ufw, allow, 443/tcp ]
%{ for cidr in admin_cidrs }
  - [ ufw, allow, from, ${cidr}, to, any, port, 22, proto, tcp ]
  - [ ufw, allow, from, ${cidr}, to, any, port, ${wireguard_port}, proto, udp ]
%{ endfor }
  - [ ufw, --force, enable ]

  # WireGuard setup
  - [ mkdir, -p, /etc/wireguard ]
  - [ sh, -c, 'wg genkey | tee /etc/wireguard/server_private.key | wg pubkey > /etc/wireguard/server_public.key' ]
  - [ sh, -c, 'cat > /etc/wireguard/wg0.conf <<EOF
[Interface]
PrivateKey = $(cat /etc/wireguard/server_private.key)
Address = 10.200.0.1/24
ListenPort = ${wireguard_port}
SaveConfig = true
EOF' ]
  - [ systemctl, enable, wg-quick@wg0 ]
  - [ systemctl, start, wg-quick@wg0 ]

  # App Peer
  - [ sh, -c, 'wg genkey | tee /etc/wireguard/app_private.key | wg pubkey > /etc/wireguard/app_public.key' ]
  - [ sh, -c, 'printf "\n[Peer]\nPublicKey = $(cat /etc/wireguard/app_public.key)\nAllowedIPs = 10.200.0.2/32\n" >> /etc/wireguard/wg0.conf' ]
  - [ systemctl, restart, wg-quick@wg0 ]

  # Admin Peer Scripts
  - [ sh, -c, 'cat > /usr/local/bin/add-admin-peer.sh <<EOF
#!/bin/bash
PEER_NAME=$1
PUBLIC_KEY=$2
ALLOWED_IP=$3
CONF_FILE=/etc/wireguard/wg0.conf
echo -e "\n# $PEER_NAME\n[Peer]\nPublicKey = $PUBLIC_KEY\nAllowedIPs = $ALLOWED_IP" >> $CONF_FILE
systemctl restart wg-quick@wg0
EOF' ]
  - [ chmod, "+x", "/usr/local/bin/add-admin-peer.sh" ]

  - [ sh, -c, 'cat > /usr/local/bin/remove-admin-peer.sh <<EOF
#!/bin/bash
PEER_NAME=$1
CONF_FILE=/etc/wireguard/wg0.conf
sed -i "/# $PEER_NAME/,/AllowedIPs =/d" $CONF_FILE
systemctl restart wg-quick@wg0
EOF' ]
  - [ chmod, "+x", "/usr/local/bin/remove-admin-peer.sh" ]
