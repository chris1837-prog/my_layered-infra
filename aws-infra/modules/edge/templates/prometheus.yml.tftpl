global:
  scrape_interval: 10s
scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
  - job_name: 'edge-node-exporter'
    static_configs:
      - targets: ['localhost:9100']
  - job_name: 'app-node-exporter'
    static_configs:
      - targets: ['${app_private_ip}:9100']
  - job_name: 'application'
    metrics_path: /metrics
    static_configs:
      - targets: ['${app_private_ip}:3000']