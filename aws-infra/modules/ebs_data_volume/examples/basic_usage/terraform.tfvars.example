# Copy to terraform.tfvars and adjust before applying.

aws_profile               = "layered-qa"
aws_region                = "eu-central-1"
project                   = "layered"
env                       = "qa"
availability_zone         = "eu-central-1a"
instance_type             = "t3.small"
volume_size_gb            = 100
volume_device_name        = "/dev/xvdb"
additional_tags = {
  Owner      = "Squad-C"
  BackupType = "manual"
}
