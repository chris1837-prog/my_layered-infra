# bootstrap/dev/terraform.tfvars.example

# AWS region where backend and CI/CD role will be created
aws_region = "eu-central-1"

# Project name for resource naming
project_name = "layered-infra"

# Environment name, e.g., dev, prod
environment = "dev"

# Common tags applied to all resources (default: {})
common_tags = {
  Project     = "layered-infra"
  Environment = "dev"
  Module      = "bootstrap"
  Team        = "A"
}

# GitHub organization for OIDC trust
github_org = "webeet-io"

# GitHub repository for OIDC trust
github_repo = "layered-infra"

# GitHub branch allowed to assume the CI/CD role (default: development)
github_branch = "development"

# Restrict Terraform permissions by Project/Environment tags (default: false)
restrict_by_tags = false

# Private Docker registry URL (required)
registry_url = "registry.example.com"

# Private Docker registry username (required)
registry_user = "admin"

# PostgreSQL database name (required)
postgres_db = "myapp"

# PostgreSQL username (required)
postgres_user = "myuser"

# Docker image tag for the application (required)
app_image_tag = "latest"

# Base domain name for Route53 hosted zone (e.g., uselayered.com)
domain_name = "uselayered.com"

# Private IP address of the edge host (used for DNS records in Route53)
edge_private_ip = "10.0.0.10"
