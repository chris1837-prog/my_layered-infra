# aws-infra/environments/qa/terraform.tfvars.example

# =======================================================
# Core Environment Variables
# =======================================================

project_name = "layered-infra"
environment  = "qa"

# --- Networking & Security ---
edge_private_ip       = "10.0.1.10"
allowed_admin_cidrs   = ["YOUR_PUBLIC_IP/32"]           # REQUIRED: Your public IP for SSH/VPN access. DO NOT use 0.0.0.0/0.

# --- Instance Key Pair ---
ec2_key_pair_name     = "layered-infra-qa-instance-key" 

# --- Application Configuration ---
docker_compose_content = file("../../../mvp-compose/docker-compose.yml")